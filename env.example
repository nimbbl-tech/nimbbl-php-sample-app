# Required
NIMBBL_ACCESS_KEY=
NIMBBL_ACCESS_SECRET=

# Optional (defaults to production if unset)
NIMBBL_API_URL=https://api.nimbbl.tech/api/
NIMBBL_API_VERSION=v3

# Optional host overrides (useful for QA/UAT)
NIMBBL_API_HOST=
NIMBBL_CHECKOUT_HOST=
NIMBBL_SAMUNNAYA_ENDPOINT=

# Logging
NIMBBL_ENABLE_LOGGING=true
NIMBBL_LOG_FILE=php://stderr
NIMBBL_DEBUG_LOGGING=false

# App mode
APP_ENV=development

